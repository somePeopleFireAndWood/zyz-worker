{
  "description": "zyz-worker watchdog：为 execute-task 工作流提供确定性的存活心跳与会话活动记录、API 错误中断记录、状态新鲜度提醒、派发侧范围守卫、共享 worktree 的 checkout 守卫、subagent 退出门、主 agent 停止门以及 IM 停止通知。所有 hook 都 fail open，且只有在本会话的任务指针（.zyz-worker/sessions/<session-id>，退回时为 .zyz-worker/current-task）能解析时才生效。设置 ZYZ_HOOKS_DISABLE=1 可整体关闭（ZYZ_SCOPE_GUARD_DISABLE=1 只关范围守卫；ZYZ_CHECKOUT_GUARD_DISABLE=1 只关 checkout 守卫；ZYZ_NOTIFY_DISABLE=1 只关 IM 通知）。",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/main-state.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/heartbeat.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(Agent|spawn_agent|collaboration\\.spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/dispatch-scope-guard.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(Bash|exec_command|functions\\.exec)$",
        "hooks": [
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/checkout-guard.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/heartbeat.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/status-freshness.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(Agent|spawn_agent|collaboration\\.spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/post-agent-flush.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(zyz-worker:)?(implementation-agent|test-agent|review-agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/subagent-track.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(zyz-worker:)?(implementation-agent|test-agent|review-agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/stop-gate-subagent.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/stop-gate-main.sh\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/main-state.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/notify.sh\"",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/notify.sh\"",
            "async": true,
            "timeout": 15
          },
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/api-failure.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/notify.sh\"",
            "async": true,
            "timeout": 15
          },
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/main-state.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zyz_hook_plugin_root=\"${PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-}}}}\"; if [ -z \"$zyz_hook_plugin_root\" ]; then exit 0; fi; \"$zyz_hook_plugin_root/hooks/scripts/start-watchdog.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
