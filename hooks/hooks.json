{
  "description": "zyz-worker watchdog: deterministic liveness heartbeats, status-freshness reminders, dispatch-side scope guard, subagent exit gate, and main-agent stop gate for the execute-task workflow. All hooks fail open and no-op unless the session cwd has a .zyz-worker/current-task pointer. Set ZYZ_HOOKS_DISABLE=1 to disable (ZYZ_SCOPE_GUARD_DISABLE=1 for the scope guard alone).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/heartbeat.sh",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "^Agent$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/dispatch-scope-guard.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/heartbeat.sh",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/status-freshness.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^Agent$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/post-agent-flush.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(zyz-worker:)?(implementation-agent|test-agent|review-agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/subagent-track.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(zyz-worker:)?(implementation-agent|test-agent|review-agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/stop-gate-subagent.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/stop-gate-main.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
