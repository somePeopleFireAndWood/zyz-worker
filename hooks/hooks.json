{
  "description": "zyz-worker watchdog: deterministic liveness heartbeats, status-freshness reminders, dispatch-side scope guard, shared-worktree checkout guard, subagent exit gate, and main-agent stop gate for the execute-task workflow. All hooks fail open and no-op unless a .zyz-worker/current-task pointer resolves. Set ZYZ_HOOKS_DISABLE=1 to disable (ZYZ_SCOPE_GUARD_DISABLE=1 for the scope guard alone; ZYZ_CHECKOUT_GUARD_DISABLE=1 for the checkout guard alone).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}}\"/hooks/scripts/heartbeat.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(Agent|spawn_agent|collaboration\\.spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}}\"/hooks/scripts/dispatch-scope-guard.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(Bash|exec_command|functions\\.exec)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}}\"/hooks/scripts/checkout-guard.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}}\"/hooks/scripts/heartbeat.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}}\"/hooks/scripts/status-freshness.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(Agent|spawn_agent|collaboration\\.spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}}\"/hooks/scripts/post-agent-flush.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(zyz-worker:)?(implementation-agent|test-agent|review-agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}}\"/hooks/scripts/subagent-track.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(zyz-worker:)?(implementation-agent|test-agent|review-agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}}\"/hooks/scripts/stop-gate-subagent.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}}\"/hooks/scripts/stop-gate-main.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT:-${ZYZ_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}}\"/hooks/scripts/start-watchdog.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
